# Polymarket wallet (L1) private key - used to derive CLOB API creds and sign orders.
# Fund this wallet with USDC.e on Polygon.
POLYMARKET_PRIVATE_KEY=

# Funder address (the proxy/safe that actually holds USDC). For EOA signer with
# no proxy, set this to the same wallet address derived from the private key.
POLYMARKET_FUNDER_ADDRESS=

# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=

# Trading behavior
DRY_RUN=true                 # true = log only, no orders
COPY_NOTIONAL_USDC=10        # fixed USDC size per copied trade
MAX_OPEN_POSITIONS=20        # safety cap
POLL_INTERVAL_MS=30000       # how often to poll tracked wallets

# Wallet filtering (applied at watch startup)
MIN_WIN_RATE=0.6             # drop wallets below this win rate
MIN_SETTLED_MARKETS=30       # drop wallets with insufficient sample

# Dashboard
DASHBOARD_PORT=3000
