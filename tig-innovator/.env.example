# TIG Innovator credentials & config
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Identity ---
# Display name shown on TIG submissions / leaderboards
TIG_INNOVATOR_NAME=

# Ethereum address (Base L2) used to sign submissions on play.tig.foundation
TIG_PLAYER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Submission preferences ---
# Default challenge to scaffold against: satisfiability | vehicle_routing |
# knapsack | vector_search | hypergraph | neuralnet_optimizer |
# job_scheduling | energy_arbitrage
TIG_DEFAULT_CHALLENGE=knapsack

# --- Local dev images ---
# Override if TIG bumps the version. Check tig/tig-benchmarker/.env for current.
TIG_IMAGE_VERSION=0.0.5

# --- Optional: Advance submissions ---
# Email used in the "Advance Submission (<ADVANCE>)" thread to advances@tig.foundation
TIG_ADVANCE_EMAIL=
